# PostgreSQL OLTP credentials
# Copy this file to .env and adjust values for your local environment.
# These variables are used by docker-compose.oltp.yml and docker-compose.cdc.yml.
DB_HOST=postgres-oltp
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=fraud_bank

# Grafana configuration
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# Shared by Airflow 3 components to sign task execution tokens.
# Generate a unique value before sharing or deploying the environment.
AIRFLOW_JWT_SECRET=replace-with-a-random-secret

# Alertmanager sends firing and resolved pipeline alerts to this Discord webhook.
# Leave empty to evaluate alerts without external delivery.
DISCORD_WEBHOOK_URL=
