# Copy to profiles.yml and fill in any environment-specific values.
# profiles.yml is gitignored — only this example file is committed.
fraud_detection:
  target: dev
  outputs:
    dev:
      type: trino
      method: none
      host: "{{ env_var('TRINO_HOST', 'localhost') }}"
      port: "{{ env_var('TRINO_PORT', '8090') | int }}"
      user: "{{ env_var('TRINO_USER', 'dbt') }}"
      database: lakehouse
      schema: staging
      http_scheme: http  # Override to https when Trino is TLS-terminated in production
      threads: 4
      session_properties:
        query_max_execution_time: 30m
